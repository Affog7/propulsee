# Copier en .env (cp .env.example .env). Lu par docker compose, l'API et le build de l'extension.
# Toutes les valeurs ont un défaut : le .env est optionnel en dev local.

# --- Postgres (docker compose) ---
POSTGRES_USER=propulsee
POSTGRES_PASSWORD=propulsee
POSTGRES_DB=propulsee
# Port exposé sur la machine hôte : 5433 pour ne pas entrer en conflit avec un Postgres installé localement (5432).
# Si vous le changez, mettez aussi DATABASE_URL à jour.
POSTGRES_PORT=5433

# --- API ---
# Port de l'API sur la machine hôte (npm run dev comme docker compose).
PORT=3000
DATABASE_URL=postgres://propulsee:propulsee@localhost:5433/propulsee
LOG_LEVEL=info

# --- Extension ---
# URL de l'API appelée par l'extension (et autorisée dans son manifest).
VITE_API_URL=http://localhost:3000
