{
  "name": "propulsee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/extension"
  ],
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "concurrently -n api,ext -c cyan,magenta \"npm run dev -w @propulsee/api\" \"npm run dev -w @propulsee/extension\"",
    "dev:api": "npm run dev -w @propulsee/api",
    "dev:ext": "npm run dev -w @propulsee/extension",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
